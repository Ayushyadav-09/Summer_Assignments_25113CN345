#include<stdio.h>

int main()
{
    int arr[100], n, i, temp[100];
    int index = 0;

    printf("Enter size of array: ");
    scanf("%d", &n);

    printf("Enter array elements:\n");

    for(i = 0; i < n; i++)
    {
        scanf("%d", &arr[i]);
    }

    for(i = 0; i < n; i++)
    {
        if(arr[i] != 0)
        {
            temp[index] = arr[i];
            index++;
        }
    }

    while(index < n)
    {
        temp[index] = 0;
        index++;
    }

    printf("Array after moving zeroes:\n");

    for(i = 0; i < n; i++)
    {
        printf("%d ", temp[i]);
    }

    return 0;
}